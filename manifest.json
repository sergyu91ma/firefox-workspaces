{
  "manifest_version": 3,
  "name": "Slim Workspaces",
  "version": "1.1.1.0",
  "description": "Workspace management inspired by Microsoft Edge for Firefox.",
  "icons": {
    "48": "icons/addon-icon.svg",
    "96": "icons/addon-icon.svg"
  },
  "permissions": [
    "tabs",
    "tabHide",
    "storage",
    "activeTab",
    "tabGroups",
    "menus",
    "contextualIdentities",
    "cookies",
    "theme"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Open Workspaces",
    "default_icon": "icons/default-icon.svg"
  },
  "background": {
    "scripts": [
      "background/logger.js",
      "background/events.js",
      "background/storage.js",
      "background/state.js",
      "background/menus.js",
      "background/indicator.js",
      "background/theme.js",
      "background/manager.js",
      "background/background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "{7c0959dc-7075-4c19-b65b-38f830975df0}",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"],
        "optional": []
      }
    }
  }
}
